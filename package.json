{
  "name": "unicode",
  "publisher": "rivencode",
  "displayName": "Unicode",
  "description": "A Virtual Classroom integrated with VS Code solution.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "unicode.startWebview", "title": "Start Webview" },
      { "command": "unicode.fakeLogin", "title": "debug login" },
      { "command": "unicode.logout", "title": "logout" },
      { "command": "unicode.login", "title": "Unicode: Sign In" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unicode-icon",
          "title": "Unicode",
          "icon": ""
        }
      ]
    },
    "views": {
      "unicode-icon": [
        {
          "type": "webview",
          "id": "unicode-main",
          "name": "Unicode",
          "icon": ""
        }
      ]
    },
    "uriHandler": "unicode.auth"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.137.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.3.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
