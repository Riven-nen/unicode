{
  "name": "unicode",
  "displayName": "Unicode",
  "description": "A Virtual Classroom integrated with VS Code solution.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unicode.startWebview",
        "title": "Start Webview"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unicode-icon",
          "title": "Unicode",
          "icon": "code"
        }
      ]
    },
    "views": {
        "unicode-icon": [
            {
                "type": "webview",
                "id": "unicode-main",
                "name": "Unicode",
                "icon": ""
            },
            {
                "id": "package-outline",
                "name": "Outline",
                "icon": "list-tree"
            }
        ]
    }
  },

  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
